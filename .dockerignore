# ================================
# Ignore Gradle caches and build outputs
# ================================
.gradle/
**/build/

# ================================
# Ignore everything else by default
# ================================
*

# ================================
# But allow these for Docker build context:
# ================================

# Dockerfile itself
!Dockerfile

# Gradle wrapper scripts and wrapper JAR
!gradlew
!gradlew.bat
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Build configuration files
!build.gradle
!settings.gradle

# The source code
!src/
!src/**

# keep .dockerignore so you can iterate
!.dockerignore
